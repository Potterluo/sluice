# Sluice 环境变量样例 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除）
# 注意：所有变量也可直接在 shell 中 export/set。

# ---------- 执行者（聊天模型，任意 OpenAI 兼容端点） ----------
SLUICE_BASE_URL=https://api.deepseek.com/v1
SLUICE_API_KEY=sk-your-key
SLUICE_MODEL=deepseek-chat

# ---------- LLM 裁决者（可选，默认与执行者同配置） ----------
# SLUICE_JUDGE_MODEL=glm-5.3-flash
# SLUICE_JSON_MODE=1

# ---------- Jev 裁决者（System One 决策模型） ----------
# SLUICE_JEV_API_KEY=sk-or-your-openrouter-key     # 或设 OPENROUTER_API_KEY
# SLUICE_JEV_MODEL=typesafe/jev-1.14
# SLUICE_JEV_BASE_URL=https://openrouter.ai/api/alpha
# 302.ai 直连形态：SLUICE_JEV_BASE_URL=https://api.302.ai/typesafeai
# 本地 llama.cpp：SLUICE_JEV_BASE_URL=http://127.0.0.1:18080/v1
